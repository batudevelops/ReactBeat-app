# Copy to .env only to override the defaults in app.config.js.
# Debug builds still request Google's test ad units from admob.ts.
# Release builds use the AdMob console ids below.

# --- Sentry (EAS secret recommended: eas secret:create --name SENTRY_AUTH_TOKEN) ---
# SENTRY_AUTH_TOKEN=
# SENTRY_DSN=

# --- RevenueCat (Project settings → API keys → Public app-specific keys) ---
# iOS App Store sandbox/prod: appl_... (NOT test_...)
# Android Play: goog_... (after Play app is linked in RevenueCat)
# REVENUECAT_IOS_API_KEY=appl_...
# REVENUECAT_ANDROID_API_KEY=goog_...

# --- AdMob (already the defaults in app.config.js; uncomment to override) ---
# ADMOB_IOS_APP_ID=ca-app-pub-3161783302871546~8347027369
# ADMOB_ANDROID_APP_ID=ca-app-pub-3161783302871546~8253178501
# ADMOB_IOS_INTERSTITIAL_ID=ca-app-pub-3161783302871546/3252437180
# ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-3161783302871546/4313933491
# ADMOB_IOS_REWARDED_ID=ca-app-pub-3161783302871546/6836458973
# ADMOB_ANDROID_REWARDED_ID=ca-app-pub-3161783302871546/3992849384

# --- Google Sign-In (optional override) ---
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_IOS_URL_SCHEME=
