# Copy to .env and fill before EAS build or local prebuild with prod keys.
# Dev builds use Google AdMob test IDs from app.config.js by default.

# --- Sentry (EAS secret recommended: eas secret:create --name SENTRY_AUTH_TOKEN) ---
# SENTRY_AUTH_TOKEN=
# SENTRY_DSN=

# --- RevenueCat (Project settings → API keys → Public app-specific keys) ---
# iOS App Store sandbox/prod: appl_... (NOT test_...)
# Android Play: goog_... (after Play app is linked in RevenueCat)
# REVENUECAT_IOS_API_KEY=appl_...
# REVENUECAT_ANDROID_API_KEY=goog_...

# --- AdMob (AdMob Console → Apps + Ad units) ---
# ADMOB_IOS_APP_ID=ca-app-pub-XXXX~YYYY
# ADMOB_ANDROID_APP_ID=ca-app-pub-XXXX~YYYY
# ADMOB_IOS_INTERSTITIAL_ID=ca-app-pub-XXXX/ZZZZ
# ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-XXXX/ZZZZ
# ADMOB_IOS_REWARDED_ID=ca-app-pub-XXXX/ZZZZ
# ADMOB_ANDROID_REWARDED_ID=ca-app-pub-XXXX/ZZZZ

# --- Google Sign-In (optional override) ---
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_IOS_URL_SCHEME=
